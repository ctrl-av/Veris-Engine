<Window x:Class="VerisEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VerisEditor"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" 
        Title="Veris Editor" Height="450" Width="800">
    <StackPanel Margin="25">
        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="ProjectFileLocation" TextWrapping="Wrap" Margin="0,10,0,15" />
        <TextBlock Text="{Binding ContentDirectory, StringFormat=Content directory: {0}}" />
        <TextBlock Text="{Binding GameCodeDirectory, StringFormat=Game code directory: {0}}" />
        <TextBlock Text="{Binding WindowWidth, StringFormat=Window width: {0}}" />
        <TextBlock Text="{Binding WindowHeight, StringFormat=Window height: {0}}" />
    </StackPanel>
</Window>
