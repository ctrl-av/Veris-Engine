<Window x:Class="VerisEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Title="Veris Editor" Height="800" Width="1280" MinWidth="900" MinHeight="600"
        Background="#14161B">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#E8EBF1" Padding="8,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open project…" Click="OpenProject" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitEditor" />
            </MenuItem>
        </Menu>
        <ContentControl x:Name="WorkspaceContent" />
    </DockPanel>
</Window>
