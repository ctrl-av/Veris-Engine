<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <NativeDebugSuffix Condition="'$(Configuration)' == 'Debug'">-d</NativeDebugSuffix>
    <NativeInteropDirectory>$(MSBuildThisFileDirectory)..\artifacts\bin\VerisInterop\x64\$(Configuration)\</NativeInteropDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\.dependencies\SFML-3.0.1\license.md">
      <Link>licenses\SFML.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\.dependencies\json-3.12.0\LICENSE.MIT">
      <Link>licenses\nlohmann-json.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(NativeInteropDirectory)VerisInterop.dll;$(NativeInteropDirectory)sfml-graphics$(NativeDebugSuffix)-3.dll;$(NativeInteropDirectory)sfml-window$(NativeDebugSuffix)-3.dll;$(NativeInteropDirectory)sfml-system$(NativeDebugSuffix)-3.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="ProjectTemplates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
