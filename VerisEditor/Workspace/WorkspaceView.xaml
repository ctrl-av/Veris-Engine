<UserControl x:Class="VerisEditor.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspace="clr-namespace:VerisEditor.Workspace">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <SolidColorBrush x:Key="PanelBackground" Color="#22252C" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE2EA" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9B6C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="12,10" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DDE2EA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#14161B" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#14161B">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Border Background="#292D36" Padding="16,6">
            <DockPanel>
                <Button x:Name="RefreshWorkspaceButton" DockPanel.Dock="Right" Content="Refresh workspace" Click="RefreshWorkspace" />
                <Button x:Name="RedoButton" DockPanel.Dock="Right" Content="Redo" Click="Redo" IsEnabled="{Binding History.CanRedo}" />
                <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="Undo" Click="Undo" IsEnabled="{Binding History.CanUndo}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Project.Name}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProjectFile}" FontSize="11" Foreground="#A9B6C8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="265" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="5" />
                <RowDefinition Height="200" MinHeight="110" />
            </Grid.RowDefinitions>
            <Border x:Name="HierarchyPanel" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HIERARCHY" Style="{StaticResource PanelTitle}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SceneSummary}" Foreground="#8F9BAC" Margin="12" FontSize="11" />
                    <StackPanel DockPanel.Dock="Top" Margin="6,0,6,8">
                        <TextBox x:Name="EntityNameInput" Text="{Binding EntityName, UpdateSourceTrigger=PropertyChanged}" Margin="4" Padding="4" ToolTip="Entity name" />
                        <WrapPanel>
                            <Button x:Name="CreateEntityButton" Content="Add" Click="CreateEntity" />
                            <Button x:Name="RenameEntityButton" Content="Rename" Click="RenameEntity" IsEnabled="{Binding HasSelection}" />
                            <Button x:Name="DuplicateEntityButton" Content="Duplicate" Click="DuplicateEntity" IsEnabled="{Binding HasSelection}" />
                            <Button x:Name="DeleteEntityButton" Content="Delete" Click="DeleteEntity" IsEnabled="{Binding HasSelection}" />
                        </WrapPanel>
                        <ComboBox x:Name="ParentEntityInput" ItemsSource="{Binding ParentCandidates}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedParentId}" Margin="4" ToolTip="Parent entity" />
                        <Button x:Name="ReparentEntityButton" Content="Set parent" Click="ReparentEntity" IsEnabled="{Binding HasSelection}" />
                    </StackPanel>
                    <TreeView x:Name="SceneEntities" ItemsSource="{Binding RootEntities}" SelectedItemChanged="HierarchySelectionChanged" Background="Transparent" Foreground="#DDE2EA" BorderThickness="0" Padding="8">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#DDE2EA" />
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#20242A" /></Trigger></Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <Border x:Name="ScenePanel" Grid.Column="2" Background="#191C22">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}">
                        <DockPanel>
                            <TextBlock Text="{Binding SceneTitle}" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding WindowSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8F9BAC" Margin="12,0" FontSize="11" />
                        </DockPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Background="#292D36" LastChildFill="False">
                        <TextBox x:Name="ScenePathInput" Text="{Binding ScenePathInput, UpdateSourceTrigger=PropertyChanged}" Width="145" Margin="4" ToolTip="Content-relative .verisscene file" />
                        <Button x:Name="OpenSceneButton" Content="Open" Click="OpenScene" />
                        <Button x:Name="SaveSceneButton" Content="Save" Click="SaveScene" />
                        <Button x:Name="NewSceneButton" Content="New" Click="NewScene" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Background="#292D36" LastChildFill="False">
                        <ComboBox x:Name="TransformToolInput" ItemsSource="{x:Static workspace:TransformTools.Modes}" SelectedItem="{Binding Tools.Mode}" Width="78" Margin="4" ToolTip="Move (W), rotate (E), scale (R)">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#20242A" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="Snap" IsChecked="{Binding Tools.SnapEnabled}" Foreground="#DDE2EA" VerticalAlignment="Center" Margin="4" />
                        <TextBox Text="{Binding Tools.MoveStep, UpdateSourceTrigger=PropertyChanged}" Width="42" Margin="4" ToolTip="Move grid in parent-local units" />
                        <TextBox Text="{Binding Tools.AngleStep, UpdateSourceTrigger=PropertyChanged}" Width="42" Margin="4" ToolTip="Angle increment in degrees" />
                        <TextBox Text="{Binding Tools.ScaleStep, UpdateSourceTrigger=PropertyChanged}" Width="42" Margin="4" ToolTip="Scale increment" />
                    </DockPanel>
                    <workspace:EngineViewport x:Name="SceneViewport" ToolTip="Drag to transform. W: move, E: rotate, R: scale. Ctrl: snap. Esc: cancel." />
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
            <Border x:Name="InspectorPanel" Grid.Column="4" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="INSPECTOR" Style="{StaticResource PanelTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,4">
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanVisibility}}">
                                <TextBlock Text="{Binding SelectedEntity.Name}" FontSize="16" Margin="0,0,0,12" />
                                <TextBlock Text="Transform · local coordinates" Foreground="#8F9BAC" />
                                <UniformGrid Columns="2">
                                    <StackPanel><TextBlock Text="Position X" /><TextBox x:Name="PositionXInput" Text="{Binding Inspector.PositionX, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,6,8" /></StackPanel>
                                    <StackPanel><TextBlock Text="Position Y" /><TextBox x:Name="PositionYInput" Text="{Binding Inspector.PositionY, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" /></StackPanel>
                                    <StackPanel><TextBlock Text="Scale X" /><TextBox x:Name="ScaleXInput" Text="{Binding Inspector.ScaleX, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,6,8" /></StackPanel>
                                    <StackPanel><TextBlock Text="Scale Y" /><TextBox x:Name="ScaleYInput" Text="{Binding Inspector.ScaleY, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" /></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Rotation (degrees)" /><TextBox x:Name="RotationInput" Text="{Binding Inspector.Rotation, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                <Button x:Name="ApplyTransformButton" Content="Apply transform" Click="ApplyTransform" />
                                <Expander Header="Sprite animation" Foreground="#DDE2EA">
                                    <StackPanel>
                                        <TextBlock Text="Frames: rectangle [x,y,w,h], seconds; loop and playing. Use null to remove." TextWrapping="Wrap" />
                                        <TextBox x:Name="AnimationInput" Text="{Binding AnimationJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                        <Button x:Name="ApplyAnimationButton" Content="Apply animation" Click="ApplyAnimation" />
                                        <Button Content="Advance animation 100 ms" Click="PreviewAnimation" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Audio source" Foreground="#DDE2EA">
                                    <StackPanel>
                                        <TextBlock Text="Assign an imported audio asset or edit clip, assetId, volume (0–100), loop and autoPlay. Use null to remove." TextWrapping="Wrap" />
                                        <TextBox Text="{Binding AudioJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                        <Button x:Name="ApplyAudioButton" Content="Apply audio" Click="ApplyAudio" />
                                        <WrapPanel><Button Content="Play" Click="PlayAudio" /><Button Content="Pause" Click="PauseAudio" /><Button Content="Resume" Click="ResumeAudio" /><Button Content="Stop" Click="StopAudio" /></WrapPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Physics body" Foreground="#DDE2EA">
                                    <StackPanel>
                                        <TextBlock Text="Body types: static 0, kinematic 1, dynamic 2. Shapes: box 0, circle 1. Dimensions and velocity use pixels. Root entities only. Use null to remove." TextWrapping="Wrap" />
                                        <TextBox Text="{Binding PhysicsJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                        <Button x:Name="ApplyPhysicsButton" Content="Apply physics" Click="ApplyPhysics" />
                                        <Button x:Name="StepPhysicsButton" Content="Simulate one frame (undoable)" Click="StepPhysics" />
                                        <CheckBox x:Name="PhysicsDebugToggle" Content="Draw colliders and contacts" IsChecked="{Binding PhysicsDebug}" Foreground="#DDE2EA" Margin="0,8" />
                                        <TextBlock Text="Solid: green static, blue kinematic, yellow dynamic. Cyan: trigger. White: velocity. Red: contact normal." TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ContactDetails}" TextWrapping="Wrap" Margin="0,8" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Sprite" Foreground="#8F9BAC" Margin="0,14,0,8" />
                                <TextBlock Text="Content-relative texture" />
                                <TextBox x:Name="TexturePathInput" Text="{Binding Inspector.TexturePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />
                                <Button Content="Use selected content" Click="UseSelectedTexture" />
                                <TextBlock Text="Tint (RRGGBBAA)" /><TextBox x:Name="TintInput" Text="{Binding Inspector.Tint, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                <UniformGrid Columns="2">
                                    <StackPanel><TextBlock Text="Origin X" /><TextBox Text="{Binding Inspector.OriginX, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,6,8" /></StackPanel>
                                    <StackPanel><TextBlock Text="Origin Y" /><TextBox Text="{Binding Inspector.OriginY, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" /></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Layer" /><TextBox Text="{Binding Inspector.Layer, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                <CheckBox Content="Visible" IsChecked="{Binding Inspector.Visible}" Foreground="#DDE2EA" Margin="0,4" />
                                <CheckBox Content="Use atlas rectangle" IsChecked="{Binding Inspector.UseRectangle}" Foreground="#DDE2EA" Margin="0,4" />
                                <UniformGrid Columns="2" IsEnabled="{Binding Inspector.UseRectangle}">
                                    <StackPanel><TextBlock Text="Atlas X" /><TextBox Text="{Binding Inspector.RectangleX, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,6,8" /></StackPanel>
                                    <StackPanel><TextBlock Text="Atlas Y" /><TextBox Text="{Binding Inspector.RectangleY, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" /></StackPanel>
                                    <StackPanel><TextBlock Text="Width" /><TextBox Text="{Binding Inspector.RectangleWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,6,8" /></StackPanel>
                                    <StackPanel><TextBlock Text="Height" /><TextBox Text="{Binding Inspector.RectangleHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" /></StackPanel>
                                </UniformGrid>
                                <Button x:Name="ApplySpriteButton" Content="Add / apply sprite" Click="ApplySprite" />
                                <Button x:Name="RemoveSpriteButton" Content="Remove sprite" Click="RemoveSprite" IsEnabled="{Binding Inspector.HasSprite}" Margin="4,4,4,18" />
                            </StackPanel>
                            <TextBlock Text="Project settings" FontSize="16" Margin="0,0,0,18" />
                            <TextBlock Text="Name" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding Project.Name}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="Content directory" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding Project.ContentDirectory}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="Game code directory" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding Project.GameCodeDirectory}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="Runtime window" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding WindowSummary}" Margin="0,4,0,14" />
                            <TextBlock Text="Selected content" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock x:Name="ContentSelectionDetails" Text="{Binding SelectedItem.FullName, ElementName=ContentFiles}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="Asset metadata" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding AssetDetails}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AssetDiagnostics}" Foreground="Orange" TextWrapping="Wrap" Margin="0,0,0,8" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" ResizeDirection="Rows" />
            <Border x:Name="ContentPanel" Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="CONTENT" Style="{StaticResource PanelTitle}" />
                        <Button x:Name="ContentUpButton" Content="Up" Click="NavigateUp" DockPanel.Dock="Right" />
                        <Button x:Name="ImportAssetButton" Content="Import asset…" Click="ImportAsset" DockPanel.Dock="Right" />
                        <TextBlock Text="{Binding CurrentDirectory}" VerticalAlignment="Center" Foreground="#8F9BAC" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TabControl x:Name="AssetTabs" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Files">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="4" ToolTip="Folder name" />
                                    <Button x:Name="CreateFolderButton" Content="New folder" Click="CreateFolder" />
                                    <Button Content="Register asset" Click="RegisterTexture" />
                                </StackPanel>
                                <ListBox x:Name="ContentFiles" ItemsSource="{Binding ContentEntries}" MouseDoubleClick="OpenContentDirectory" AllowDrop="True" Drop="ImportDroppedFiles">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding FullName}" Margin="4,2" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Assets">
                            <DockPanel>
                                <TextBox x:Name="AssetSearchInput" DockPanel.Dock="Top" Text="{Binding AssetSearch, UpdateSourceTrigger=PropertyChanged}" Margin="4" ToolTip="Search by path or asset ID" />
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                    <TextBox x:Name="AssetDestinationInput" Text="{Binding AssetDestination, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="4" ToolTip="Content-relative destination, including filename" />
                                    <Button x:Name="MoveAssetButton" Content="Move / rename" Click="MoveAsset" IsEnabled="{Binding HasSelectedAsset}" />
                                    <Button x:Name="UseAssetButton" Content="Use asset" Click="UseAsset" IsEnabled="{Binding HasSelectedAsset}" />
                                    <Button x:Name="ReimportAssetButton" Content="Reimport…" Click="ReimportAsset" IsEnabled="{Binding HasSelectedAsset}" />
                                    <Button x:Name="DeleteAssetButton" Content="Delete" Click="DeleteAsset" IsEnabled="{Binding HasSelectedAsset}" />
                                </StackPanel>
                                <DockPanel>
                                    <Image x:Name="AssetPreviewImage" DockPanel.Dock="Right" Source="{Binding AssetPreview}" Width="90" Margin="8" Stretch="Uniform" />
                                    <ListBox x:Name="ImportedAssetsList" ItemsSource="{Binding ImportedAssets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="Path" MouseDoubleClick="UseAsset" />
                                </DockPanel>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="2" Grid.Column="3" ResizeDirection="Columns" />
            <Border x:Name="OutputPanel" Grid.Row="2" Grid.Column="4" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OUTPUT" Style="{StaticResource PanelTitle}" />
                    <TextBox x:Name="OutputLog" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#B9C5D7" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12,0" />
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#292D36" Padding="12,0">
            <TextBlock x:Name="WorkspaceStatus" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
