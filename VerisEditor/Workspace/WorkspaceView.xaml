<UserControl x:Class="VerisEditor.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workspace="clr-namespace:VerisEditor.Workspace">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#22252C" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE2EA" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A9B6C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="12,10" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DDE2EA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="#14161B" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#14161B">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Border Background="#292D36" Padding="16,6">
            <DockPanel>
                <Button x:Name="RefreshWorkspaceButton" DockPanel.Dock="Right" Content="Refresh workspace" Click="RefreshWorkspace" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Project.Name}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProjectFile}" FontSize="11" Foreground="#A9B6C8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="265" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="5" />
                <RowDefinition Height="200" MinHeight="110" />
            </Grid.RowDefinitions>
            <Border x:Name="HierarchyPanel" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HIERARCHY" Style="{StaticResource PanelTitle}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding SceneSummary}" Foreground="#8F9BAC" Margin="12" FontSize="11" />
                    <ListBox x:Name="SceneEntities" ItemsSource="{Binding Entities}" DisplayMemberPath="Name" />
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <Border x:Name="ScenePanel" Grid.Column="2" Background="#191C22">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}">
                        <DockPanel>
                            <TextBlock Text="SCENE" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding WindowSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8F9BAC" Margin="12,0" FontSize="11" />
                        </DockPanel>
                    </Border>
                    <workspace:EngineViewport x:Name="SceneViewport" />
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
            <Border x:Name="InspectorPanel" Grid.Column="4" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="INSPECTOR" Style="{StaticResource PanelTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,4">
                            <TextBlock Text="Project settings" FontSize="16" Margin="0,0,0,18" />
                            <TextBlock Text="Name" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding Project.Name}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="Content directory" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding Project.ContentDirectory}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="Game code directory" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding Project.GameCodeDirectory}" Margin="0,4,0,14" TextWrapping="Wrap" />
                            <TextBlock Text="Runtime window" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock Text="{Binding WindowSummary}" Margin="0,4,0,14" />
                            <TextBlock Text="Selected content" Foreground="#8F9BAC" FontSize="11" />
                            <TextBlock x:Name="ContentSelectionDetails" Text="{Binding SelectedItem.FullName, ElementName=ContentFiles}" Margin="0,4,0,14" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" ResizeDirection="Rows" />
            <Border x:Name="ContentPanel" Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="CONTENT" Style="{StaticResource PanelTitle}" />
                        <Button x:Name="ContentUpButton" Content="Up" Click="NavigateUp" DockPanel.Dock="Right" />
                        <TextBlock Text="{Binding CurrentDirectory}" VerticalAlignment="Center" Foreground="#8F9BAC" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ListBox x:Name="ContentFiles" ItemsSource="{Binding ContentEntries}" MouseDoubleClick="OpenContentDirectory">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding FullName}" />
                                    <TextBlock Text="{Binding Extension}" Foreground="#8F9BAC" Margin="12,0,0,0" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Row="2" Grid.Column="3" ResizeDirection="Columns" />
            <Border x:Name="OutputPanel" Grid.Row="2" Grid.Column="4" Background="{StaticResource PanelBackground}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OUTPUT" Style="{StaticResource PanelTitle}" />
                    <TextBox x:Name="OutputLog" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#B9C5D7" BorderThickness="0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12,0" />
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#292D36" Padding="12,0">
            <TextBlock x:Name="WorkspaceStatus" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
